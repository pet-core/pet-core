{
  "expo": {
    "name": "PetCore",
    "slug": "PetCore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "petcore",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.company.petcore"
    },
    "android": {
      "package": "com.company.petcore",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7167F6",
          "defaultChannel": "avisos-clinicos"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "89852ab2-0e41-44a0-97fc-298e5a35af44"
      }
    }
  }
}
